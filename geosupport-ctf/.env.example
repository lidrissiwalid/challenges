# Generated during instance initialization — do NOT commit real values
MONGO_INITDB_ROOT_USERNAME=geosupport
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_RANDOM
MONGO_INITDB_DATABASE=geosupport

APP_SECRET=CHANGE_ME_RANDOM_32BYTES_HEX
ADMIN_SESSION_TOKEN=CHANGE_ME_RANDOM_64BYTES_HEX

# Seeded user credentials (password unknown to players — set randomly)
SEED_USER_EMAIL=alice@geosupport.local
SEED_USER_PASSWORD=CHANGE_ME_RANDOM

# Flag (injected into the SSRF worker only)
FLAG=IGT{n0sql_xss_ssrf_pwn3d}

# Internal hostname for flag service (used by ssrf-worker only)
FLAG_SERVICE_URL=http://flag-service:8080/

# Queue volume path (shared between web app and ssrf-worker)
QUEUE_PATH=/var/queue

# Public port exposed by Nginx
PUBLIC_PORT=8080
